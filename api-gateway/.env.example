# =============================================================================
# API Gateway Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values
# For production, use AWS Secrets Manager for sensitive values
# =============================================================================

# Service Configuration
NODE_ENV=production
PORT=3000

# AWS Configuration
AWS_REGION=ap-south-1
AWS_SECRETS_MANAGER_SECRET_ID=cloudretail/database-credentials

# Database Configuration (PostgreSQL via AWS RDS)
DB_NAME=postgres
DB_USER=postgres
DB_HOST=cloud-retail.czyg604m8g8n.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_PASSWORD=postgres

# Redis Configuration (AWS ElastiCache)
REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379

# JWT Secret (use Secrets Manager for production)
# JWT_SECRET should be loaded from AWS Secrets Manager in production
# JWT_SECRET=your-jwt-secret-key

# Service Discovery
SERVICE_REGISTRY=http://consul:8500

# Service URLs
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003
INVENTORY_SERVICE_URL=http://inventory-service:3004

# Logging
LOG_LEVEL=info
